# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.*
.env.local
.env.*.local

# Zoho Catalyst auth & session — contains project IDs and org IDs
.catalystrc
catalyst.json.backup

# Python virtual environments
backend/.venv/
backend/.ven/

# Python cache
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo

# Logs
backend/logs/
*.log

# Seed / generated data (may contain PII)
backend/scripts/graph_seed.cypher
backend/scripts/seed_output/

# SQLite fallback DB (if created locally)
*.db
*.sqlite3

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
